[Unit]
Description=desk-weather-bet: cancel orders unfilled after 3 h

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/desk-weather-bet
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run python bot/live.py cancel
StandardOutput=append:%h/Projects/desk-weather-bet/logs/timer_cancel.log
StandardError=append:%h/Projects/desk-weather-bet/logs/timer_cancel.log
TimeoutStartSec=6h
