[Unit]
Description=desk-weather-bet: run AIFS locally from today's 00Z open data

[Service]
Type=oneshot
WorkingDirectory=%h/Projects/desk-weather-bet
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run python bot/live.py forecast
StandardOutput=append:%h/Projects/desk-weather-bet/logs/timer_forecast.log
StandardError=append:%h/Projects/desk-weather-bet/logs/timer_forecast.log
TimeoutStartSec=6h
